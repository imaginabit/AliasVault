             return BadRequest(ApiErrorCodeHelper.CreateErrorResponse(ApiErrorCode.PUBLIC_REGISTRATION_DISABLED, 400));
         }
 
+        // Check if the username's email domain is allowed to register.
+        if (!IsRegistrationDomainAllowed(model.Username))
+        {
