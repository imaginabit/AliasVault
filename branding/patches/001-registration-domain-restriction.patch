+
         if (string.IsNullOrWhiteSpace(model.Username))
         {
             return BadRequest(ApiErrorCodeHelper.CreateErrorResponse(ApiErrorCode.USERNAME_REQUIRED, 400));
@@ -917,6 +929,34 @@ public class AuthController(IAliasServerDbContextFactory dbContextFactory, UserM
         return principal;
     }
 
+    /// <summary>
+    /// Checks whether the username's email domain is in the allowed registration domains list.
+    /// Returns true when no domain restriction is configured.
+    /// </summary>
+    /// <param name="username">The username to check.</param>
+    /// <returns>True if registration is allowed for this username, false otherwise.</returns>
+    private bool IsRegistrationDomainAllowed(string username)
+    {
+        if (config.AllowedRegistrationDomains.Count == 0)
+        {
+            return true;
+        }
+
+        if (string.IsNullOrWhiteSpace(username))
+        {
+            return false;
+        }
+
+        var atIndex = username.LastIndexOf('@');
+        if (atIndex < 1 || atIndex == username.Length - 1)
+        {
+            return false;
+        }
+
+        var domain = username[(atIndex + 1)..];
+        return config.AllowedRegistrationDomains.Contains(domain, StringComparer.OrdinalIgnoreCase);
+    }
+
     /// <summary>
     /// Validates if a given username meets the required criteria.
     /// </summary>
diff --git a/apps/server/AliasVault.Api/Program.cs b/apps/server/AliasVault.Api/Program.cs
index 9923ca0..8172efe 100644
--- a/apps/server/AliasVault.Api/Program.cs
+++ b/apps/server/AliasVault.Api/Program.cs
@@ -57,6 +57,12 @@ var hiddenPrivateEmailDomains = Environment.GetEnvironmentVariable("HIDDEN_PRIVA
     .Where(d => !string.IsNullOrWhiteSpace(d));
 config.HiddenPrivateEmailDomains = hiddenPrivateEmailDomains?.ToList() ?? new List<string>();
 
+var allowedRegistrationDomains = Environment.GetEnvironmentVariable("ALLOWED_REGISTRATION_DOMAINS")?
+    .Split(",", StringSplitOptions.RemoveEmptyEntries)
+    .Select(d => d.Trim().TrimStart('@').ToLowerInvariant())
+    .Where(d => !string.IsNullOrWhiteSpace(d));
+config.AllowedRegistrationDomains = allowedRegistrationDomains?.ToList() ?? new List<string>();
+
 var ipLoggingEnabled = Environment.GetEnvironmentVariable("IP_LOGGING_ENABLED") ?? "false";
 config.IpLoggingEnabled = bool.Parse(ipLoggingEnabled);
 
