# ============================================
# MyVault - Custom AliasVault Configuration
# Copy this to .env and edit for your deployment
# ============================================

# --- Branding (must match branding.json) ---
APP_NAME_SAFE=myvault
APP_DISPLAY_NAME=MyVault
DOCKER_REGISTRY=ghcr.io/your-org
DOCKER_IMAGE_PREFIX=myvault

# --- Server Configuration ---
POSTGRES_PASSWORD=change-me-strong-password
SECRETS_PATH=/secrets
FORCE_HTTPS_REDIRECT=true
PUBLIC_REGISTRATION_ENABLED=true

# --- Hostname & Email ---
ALIASVAULT_HOSTNAME=myvault.example.com
ALLOWED_HOSTS=myvault.example.com
EMAIL_DOMAIN=example.com
SMTP_HOSTNAME=mail.myvault.example.com

# --- Ports ---
HTTP_PORT=80
HTTPS_PORT=443
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587

# --- Database ---
POSTGRES_DATABASE=aliasvault
POSTGRES_USER=aliasvault